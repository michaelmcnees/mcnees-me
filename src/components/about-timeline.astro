---
interface TimelineEntry {
  period: string;
  role: string;
  description: string;
}

const entries: TimelineEntry[] = [
  {
    period: "2026 – now",
    role: "Director of Application Development, Crawford & Company",
    description:
      "Leading three engineering teams and providing technical oversight for a portfolio of 50+ customer-facing, internal, and hybrid applications. Modernizing legacy Angular apps to React and React Native, and running a follow-the-sun support model with global coverage, incident retrospectives, and RFC-based design reviews.",
  },
  {
    period: "2025 – 2026",
    role: "Engineering Manager, WeGoLook / Crawford & Company",
    description:
      "Led a multi-functional team spanning frontend, backend, mobile, and cloud engineering. Drove major platform migrations to React Native, Next.js, and Go, moved core workflows to event-driven services, and brought agentic engineering tooling into the team's everyday workflow.",
  },
  {
    period: "2022 – 2024",
    role: "Lead Frontend Engineer, WeGoLook",
    description:
      "Took over frontend leadership for a team in the middle of a modernization effort. Trained the team on TypeScript, Next.js, and Tailwind, led a full frontend ecosystem transition, and introduced internal component libraries and advanced deployment tooling.",
  },
  {
    period: "2023",
    role: "Senior Web Developer (Part-time), Hygieia Inc.",
    description:
      "Led frontend engineering for a health-tech startup building a type 2 diabetes management platform. Loved the mission and the team.",
  },
  {
    period: "2022",
    role: "Senior Consultant, Rural Sourcing (now Sparq)",
    description:
      "Grew from frontend engineer to senior level, took on a direct report, and joined the interview team. First fully remote role, working across multiple client engagements.",
  },
  {
    period: "2021 – 2022",
    role: "Software Engineer, Sweetwater Sound",
    description:
      "Promoted from IT after completing my degree. Built and maintained internal applications in Laravel and WordPress, learning the full stack from databases to deployment.",
  },
  {
    period: "2018 – 2021",
    role: "IT Delivery Specialist, Sweetwater Sound",
    description:
      "Coordinated software releases and produced documentation for the company. Researched and implemented new tools for the internal dev environment, managed third-party developer relationships, and maintained multiple WordPress and PHP applications. Also provided support for Sweetwater's B2B vendor platform.",
  },
  {
    period: "2015 – 2018",
    role: "Technical Support Technician, Sweetwater Sound",
    description:
      "Started in customer support helping studio engineers with complex networked audio systems. Earned certifications in digital control systems before moving to the internal IT team.",
  },
];
---
<ol class="timeline">
  {entries.map((entry) => (
    <li>
      <span class="period">{entry.period}</span>
      <div class="detail">
        <h3 class="role">{entry.role}</h3>
        <p class="desc">{entry.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 4px 20px;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }
  .timeline li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .period {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.9;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .role {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--fg);
  }
  .desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-soft);
  }
  @media (max-width: 520px) {
    .timeline li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
