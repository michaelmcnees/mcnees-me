---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { name, tagline, status, stack, url, repo } = entry.data;
---
<article class="project" id={entry.id}>
  <header class="head">
    <h2 class="name">{name}</h2>
    <span class="mono">{status}</span>
  </header>
  <p class="tagline">{tagline}</p>
  <div class="body-text">
    <slot />
  </div>
  {stack.length > 0 && <p class="mono stack">{stack.join(" · ")}</p>}
  {(url || repo) && (
    <p class="links">
      {url && <a href={url} target="_blank" rel="noopener">Visit site</a>}
      {repo && <a href={repo} target="_blank" rel="noopener">Source</a>}
    </p>
  )}
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 0;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 24px;
  }
  .project:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .name {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .tagline {
    font-size: 17px;
    line-height: 1.55;
    color: var(--fg);
  }
  .body-text {
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg-soft);
  }
  .body-text :global(p + p) {
    margin-top: 12px;
  }
  .stack {
    line-height: 1.6;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 15px;
  }
</style>
