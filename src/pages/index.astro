---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/base-layout.astro";
import SocialLinks from "@/components/social-links.astro";
import { sortProjects } from "@/utils/projects";

const projects = sortProjects(await getCollection("projects", ({ data }) => !data.draft));
---
<BaseLayout title="Michael McNees">
  <section class="section intro">
    <h1 class="lede">I lead engineering teams by day and build my own software on nights and weekends.</h1>
    <p class="body">
      I care about teams that ship reliable software without burning out, and I spend a lot of time on
      how agentic tooling changes the way engineers work. Frontend is home base. Lately I spend more time
      in Go, Postgres and Cloudflare. I live in West Michigan.
    </p>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="label">Projects</h2>
    <ul class="project-list">
      {projects.map(({ id, data }) => (
        <li>
          <a href={`/projects#${id}`}>
            <span class="name">{data.name}</span>
            <span class="mono status">{data.status}</span>
            <span class="tagline">{data.tagline}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="now-heading">
    <h2 id="now-heading" class="label">Now</h2>
    <p class="body">
      Building Mantle and Honeydew, moving the house off Home Assistant and onto Homey, and upgrading the
      homelab. Off the clock: two kids, retro games, and a bass I don't play enough.
    </p>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="label">Elsewhere</h2>
    <SocialLinks />
  </section>
</BaseLayout>

<style>
  .intro {
    gap: 20px;
  }
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 24px;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }
  .project-list li:last-child a {
    border-bottom: 1px solid var(--rule);
  }
  .name {
    font-weight: 600;
    font-size: 17px;
  }
  .status {
    align-self: center;
  }
  .tagline {
    grid-column: 1 / -1;
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-soft);
  }
  .project-list a:hover .name {
    color: var(--accent);
  }
</style>
